[Unit]
Description=Psystem Scheduler Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=psystem
WorkingDirectory=/opt/psystem-agent
ExecStart=/usr/bin/java -jar /opt/psystem-agent/psystem-scheduler-agent.jar \
  --spring.config.additional-location=file:/opt/psystem-agent/application-customer.yml
EnvironmentFile=/opt/psystem-agent/psystem-agent.env
Restart=on-failure
RestartSec=10
# Allow Spring's ContextClosedEvent-based graceful shutdown handler to run before SIGKILL.
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
